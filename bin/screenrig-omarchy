#!/usr/bin/env python3
"""screenRIG for Omarchy: the helper behind the shell plugin, menu rows and hooks.

Every command prints one JSON line on stdout ({"ok": bool, ...}); `follow`
prints one line per snapshot or event until it is stopped.
"""

import base64
import glob
import hashlib
import http.client
import json
import mimetypes
import os
import re
import secrets
import shutil
import signal
import socket
import subprocess
import sys
import tempfile
import threading
import time
import urllib.error
import urllib.parse
import urllib.request

PLUGIN_ID = "screenrig.omarchy"
HOME = os.path.expanduser("~")
CONFIG = os.environ.get("SCREENRIG_CONFIG") or os.path.join(
    os.environ.get("XDG_CONFIG_HOME") or os.path.join(HOME, ".config"), "screenrig", "config.json")
CACHE = os.path.join(os.environ.get("XDG_CACHE_HOME") or os.path.join(HOME, ".cache"), "screenrig-omarchy")
STATE = os.path.join(os.environ.get("XDG_STATE_HOME") or os.path.join(HOME, ".local", "state"), "screenrig-omarchy")
MENU_FILE = os.path.join(HOME, ".config", "omarchy", "extensions", "omarchy-menu.jsonc")
THEME_COLORS = os.path.join(os.environ.get("XDG_STATE_HOME") or os.path.join(HOME, ".local", "state"),
                            "omarchy", "current", "theme", "colors.toml")
DASHBOARD = "https://screenrig.ai/dashboard"
PLAYER_STATE = os.path.join(STATE, "player")
RENEW_MARGIN_S = 120
MENU_BEGIN = "  // screenrig-omarchy:begin (generated by screenrig-omarchy menu-sync; edits here are replaced)"
MENU_END = "  // screenrig-omarchy:end"

_print_lock = threading.Lock()


class Problem(Exception):
    """An API or local failure with a message a person can act on."""


def emit(obj):
    with _print_lock:
        sys.stdout.write(json.dumps(obj, separators=(",", ":")) + "\n")
        sys.stdout.flush()


def warn(msg):
    with _print_lock:
        sys.stderr.write("screenrig-omarchy: " + msg + "\n")
        sys.stderr.flush()


# ---------------------------------------------------------------- config/auth

def load_config():
    try:
        with open(CONFIG) as f:
            return json.load(f)
    except FileNotFoundError:
        raise Problem("Not signed in: %s is missing. Run `screenrig login`." % CONFIG)


def token_exp(token):
    try:
        part = token.split(".")[1]
        claims = json.loads(base64.urlsafe_b64decode(part + "=" * (-len(part) % 4)))
        return float(claims.get("exp", 0))
    except Exception:
        return 0.0


# Where each agent keeps the installed screenRIG plugin, and how to install it there.
PLUGIN_CACHES = {
    "claude": os.path.join(HOME, ".claude", "plugins", "cache", "screenrig", "screenrig"),
    "codex": os.path.join(HOME, ".codex", "plugins", "cache", "screenrig", "screenrig"),
    "grok": os.path.join(HOME, ".grok", "installed-plugins"),
}
PLUGIN_SOURCE = "https://github.com/screenrig/plugin.git"
PLUGIN_INSTALL = {
    "claude": [["claude", "plugin", "marketplace", "add", PLUGIN_SOURCE, "--scope", "user"],
               ["claude", "plugin", "install", "screenrig@screenrig", "--scope", "user"]],
    "codex": [["codex", "plugin", "marketplace", "add", PLUGIN_SOURCE, "--ref", "main", "--json"],
              ["codex", "plugin", "add", "screenrig@screenrig", "--json"]],
    "grok": [["grok", "plugin", "install", PLUGIN_SOURCE + "#plugins/screenrig", "--trust"]],
}
AGENT_NAMES = {"claude": "Claude Code", "codex": "Codex", "grok": "Grok"}


def plugin_dirs(agent):
    """Plugin roots, excluding marketplace downloads and other plugins."""
    cache = PLUGIN_CACHES.get(agent)
    if not cache:
        return []
    pattern = "screenrig-*" if agent == "grok" else "*"
    return glob.glob(os.path.join(cache, pattern))


def installed_plugin_dirs(agent):
    return [path for path in plugin_dirs(agent)
            if os.path.isfile(os.path.join(path, "skills", "screenrig", "SKILL.md"))]


def panel_agent():
    """Prefer the default agent's installed integration, then any installed one."""
    preferred = default_agent()
    available = [agent for agent in PLUGIN_CACHES if shutil.which(agent)]
    ordered = ([preferred] if preferred in available else []) + [agent for agent in available if agent != preferred]
    return next((agent for agent in ordered if installed_plugin_dirs(agent)),
                ordered[0] if ordered else preferred)


def cli_command():
    """The screenRIG CLI: $SCREENRIG_CLI, the newest bundled plugin CLI, then `screenrig` on PATH."""
    env = os.environ.get("SCREENRIG_CLI")
    if env:
        return env.split()
    bundled = sorted((os.path.join(root, "cli", "dist", "bin.js") for agent in PLUGIN_CACHES
                      for root in plugin_dirs(agent)
                      if os.path.isfile(os.path.join(root, "cli", "dist", "bin.js"))),
                     key=cli_version)
    node = shutil.which("node")
    if bundled and node:
        return [node, bundled[-1]]
    path = shutil.which("screenrig")
    return [path] if path else None


def cli_version(path):
    root = os.path.dirname(os.path.dirname(os.path.dirname(path)))
    version = os.path.basename(root)
    # Grok names installations with a hash, keeping the version in the manifest.
    try:
        with open(os.path.join(root, ".claude-plugin", "plugin.json")) as f:
            version = json.load(f).get("version") or version
    except (OSError, ValueError):
        pass
    return [int(x) if x.isdigit() else 0 for x in version.split(".")]


def renew_token():
    """The CLI owns the refresh family (lock, rotation, recovery); a free call makes it renew."""
    cmd = cli_command()
    if not cmd:
        raise Problem("The screenRIG CLI is not installed, so the sign-in cannot be renewed. Install the screenRIG plugin.")
    proc = subprocess.run(cmd + ["billing", "balance", "--json"], capture_output=True, text=True, timeout=60)
    if proc.returncode != 0:
        detail = (proc.stdout or proc.stderr or "").strip().splitlines()
        raise Problem("Renewing the sign-in failed: %s" % (detail[-1] if detail else "exit %d" % proc.returncode))


def run_cli(args, timeout=60):
    """Run the screenRIG CLI with --json and return its data, or raise its problem."""
    cmd = cli_command()
    if not cmd:
        raise Problem("The screenRIG CLI is not installed. Install the screenRIG plugin.")
    proc = subprocess.run(cmd + args + ["--json"], capture_output=True, text=True, timeout=timeout)
    try:
        envelope = json.loads(proc.stdout)
    except ValueError:
        detail = (proc.stderr or proc.stdout or "").strip().splitlines()
        raise Problem(detail[-1] if detail else "The CLI exited with %d" % proc.returncode)
    if not envelope.get("ok"):
        problem = envelope.get("problem") or envelope.get("error") or {}
        raise Problem(problem.get("detail") or problem.get("title") or "The CLI refused: %s" % " ".join(args))
    return envelope.get("data") or {}


def list_projects():
    cfg = load_config()
    current = cfg.get("project_id")
    data = run_cli(["project", "list"])
    out = []
    for row in data.get("projects") or []:
        p = row.get("project") or {}
        org = row.get("organization") or {}
        out.append({"id": p.get("id"), "name": p.get("name") or p.get("id"), "organization": org.get("name", ""),
                    "organization_id": org.get("id", ""), "screens": p.get("screen_count", 0),
                    "current": p.get("id") == current})
    out.sort(key=lambda r: (r["organization"].lower(), r["name"].lower()))
    return out


def onboarding():
    """Use an installed agent integration; offer installation only when needed."""
    agent = panel_agent()
    plugin = bool(installed_plugin_dirs(agent))
    try:
        cfg = load_config()
        signed_in = bool(cfg.get("token") or cfg.get("identity_token"))
    except (Problem, ValueError):
        signed_in = False
    return {"ok": True, "agent": agent, "agent_name": AGENT_NAMES.get(agent, agent),
            "installable": agent in PLUGIN_INSTALL and bool(shutil.which(PLUGIN_INSTALL[agent][0][0])),
            "plugin": plugin, "cli": cli_command() is not None, "signed_in": signed_in}


def install_plugin():
    """Install the official screenRIG plugin into the selected available agent, when asked."""
    agent = panel_agent()
    steps = PLUGIN_INSTALL.get(agent)
    if not steps:
        raise Problem("Install the screenRIG plugin for %s from %s" % (agent, PLUGIN_SOURCE.removesuffix(".git")))
    if not shutil.which(steps[0][0]):
        raise Problem("%s is not on PATH" % steps[0][0])
    for step in steps:
        proc = subprocess.run(step, capture_output=True, text=True, timeout=300)
        out = (proc.stdout + proc.stderr).lower()
        if proc.returncode != 0 and "already" not in out:
            detail = (proc.stderr or proc.stdout or "").strip().splitlines()
            raise Problem("Plugin install failed: %s" % (detail[-1] if detail else "%s exited %d" % (step[0], proc.returncode)))
    if cli_command() is None:
        raise Problem("The plugin is installed, but its CLI needs Node.js (node on PATH)")
    return "Installed the screenRIG plugin for %s" % AGENT_NAMES.get(agent, agent)


def login_start():
    """Ask for a person's approval in the dashboard; opens the approval page with its code."""
    data = run_cli(["login", "--no-wait"])
    pending = data.get("login") or data
    url = pending.get("verification_uri_complete") or pending.get("verification_uri")
    if url:
        open_url(url)
    return {"ok": True, "login": pending.get("login_id") or pending.get("id"), "code": pending.get("user_code", ""),
            "url": url or ""}


def login_wait(login):
    """Wait for the approval; the CLI stores the sign-in and selects the approved project."""
    run_cli(["login", "--resume", login], timeout=24 * 3600)
    cfg = load_config()
    return "Added %s" % (cfg.get("project_name") or "the project")


def use_project(project):
    data = run_cli(["project", "use", project])
    name = ((data.get("project") or {}).get("name")) or project
    return "Switched to %s" % name


def access_token(force=False):
    cfg = load_config()
    token = cfg.get("token") or cfg.get("identity_token")
    if force or not token or token_exp(token) - time.time() < RENEW_MARGIN_S:
        if not cfg.get("oauth") and token:
            return cfg, token
        renew_token()
        cfg = load_config()
        token = cfg.get("token") or cfg.get("identity_token")
    if not token:
        raise Problem("Not signed in. Run `screenrig login`.")
    return cfg, token


def project_id(cfg):
    pid = cfg.get("project_id")
    if not pid:
        raise Problem("No project is selected. Run `screenrig project select`.")
    return pid


# ---------------------------------------------------------------------- HTTP

CREDITS = {}


def _note_credits(headers):
    low = headers.get("ScreenRig-Credits-Low")
    if low is not None:
        CREDITS["low"] = low == "true"
        try:
            CREDITS["remaining"] = int(headers.get("ScreenRig-Credits-Remaining") or 0)
        except ValueError:
            pass


def error_body(err):
    """An HTTP error answer's body; empty when the connection dropped while it was read."""
    try:
        return err.read().decode(errors="replace")
    except (http.client.HTTPException, OSError):
        return ""


def problem_message(status, body):
    try:
        p = json.loads(body)
        return p.get("detail") or p.get("title") or ("HTTP %d" % status)
    except Exception:
        return "HTTP %d" % status


def api(method, path, body=None, idempotent=False, raw=False, headers=None, _retried=False):
    cfg, token = access_token()
    url = cfg.get("api_url", "https://api.screenrig.ai").rstrip("/") + path
    h = {"Authorization": "Bearer " + token, "Accept": "application/json", "User-Agent": "screenrig-omarchy"}
    data = None
    if body is not None:
        data = json.dumps(body).encode()
        h["Content-Type"] = "application/json"
    if idempotent:
        h["Idempotency-Key"] = "omarchy-" + secrets.token_hex(16)
    h.update(headers or {})
    req = urllib.request.Request(url, data=data, method=method, headers=h)
    try:
        with urllib.request.urlopen(req, timeout=30) as resp:
            _note_credits(resp.headers)
            payload = resp.read()
            if raw:
                return payload, resp.headers
            return json.loads(payload) if payload else {}
    except urllib.error.HTTPError as err:
        payload = error_body(err)
        if err.code == 401 and not _retried and "invalid_token" in (err.headers.get("WWW-Authenticate") or ""):
            access_token(force=True)
            return api(method, path, body, idempotent, raw, headers, _retried=True)
        raise Problem(problem_message(err.code, payload))
    except urllib.error.URLError as err:
        raise Problem("Cannot reach screenRIG: %s" % err.reason)
    except (http.client.HTTPException, OSError, ValueError) as err:
        # A body cut short, a reset or timeout while reading it, or a 200 that is not JSON.
        raise Problem("screenRIG sent an incomplete or unreadable answer: %s" % (str(err) or type(err).__name__)) from err


def paged(path):
    items, cursor = [], None
    while True:
        sep = "&" if "?" in path else "?"
        page = api("GET", path + (sep + "after=" + urllib.parse.quote(cursor) if cursor else ""))
        items.extend(page.get("items") or [])
        cursor = page.get("next_cursor")
        if not cursor:
            return items


# ------------------------------------------------------------------ snapshot

def shot_path(screen_id):
    return os.path.join(CACHE, "shots", screen_id + ".webp")


def summarize_screen(s, names):
    eff = s.get("effective_playlist") or {}
    display = s.get("display") or {}
    host = s.get("host") or {}
    upgrade = s.get("manifest_upgrade") or {}
    takeover = s.get("takeover") or {}
    path = shot_path(s["id"])
    return {
        "id": s["id"],
        "label": s.get("label") or s["id"],
        "online": bool(s.get("online")),
        "state": s.get("state"),
        "last_seen_at": s.get("last_seen_at"),
        "last_online_at": s.get("last_online_at"),
        "playlist_id": s.get("playlist_id"),
        "playlist_name": names.get(s.get("playlist_id"), ""),
        "playing_id": eff.get("id"),
        "playing_name": names.get(eff.get("id"), (upgrade.get("active_playlist") or {}).get("name", "")),
        "playing_source": eff.get("source", ""),
        "playing_until": eff.get("until"),
        "takeover_until": takeover.get("until") if takeover else None,
        "has_takeover": bool(takeover),
        "display_off": display.get("requested") == "off",
        "suspended": bool(s.get("suspension")),
        "upgrade_state": upgrade.get("state", ""),
        "platform": host.get("platform") or (s.get("player") or {}).get("kind", ""),
        "capabilities": host.get("capabilities") or [],
        "shot": path if os.path.exists(path) else "",
        "shot_mtime": int(os.path.getmtime(path)) if os.path.exists(path) else 0,
    }


def snapshot():
    cfg, _ = access_token()
    pid = project_id(cfg)
    playlists = paged("/api/playlists?project=" + pid)
    names = {p["id"]: p.get("name") or p["id"] for p in playlists}
    screens = [summarize_screen(s, names) for s in paged("/api/screens?project=" + pid)
               if s.get("state") == "active"]
    screens.sort(key=lambda s: (not s["online"], s["label"].lower()))
    return {
        "kind": "snapshot",
        "at": time.time(),
        "project": {"id": pid, "name": cfg.get("project_name", ""), "organization": cfg.get("organization_name", "")},
        "screens": screens,
        "playlists": [{"id": p["id"], "name": names[p["id"]], "approved": p.get("approved_revision") is not None}
                      for p in sorted(playlists, key=lambda p: names[p["id"]].lower())],
        "credits": dict(CREDITS),
    }


def fetch_shot(screen_id, fresh=False):
    os.makedirs(os.path.dirname(shot_path(screen_id)), exist_ok=True)
    capture = ""
    if fresh:
        started = api("POST", "/api/screens/%s/screenshot" % screen_id, idempotent=True)
        capture = started.get("capture_id", "")
        deadline = time.time() + 30
        while time.time() < deadline:
            status = api("GET", "/api/screens/%s/screenshot/status" % screen_id)
            if status.get("state") == "ready":
                break
            if status.get("state") in ("timed_out", "unavailable"):
                raise Problem("The screen did not return a screenshot (%s)." % status.get("state"))
            time.sleep(1)
    q = "?capture_id=" + urllib.parse.quote(capture) if capture else ""
    data, _ = api("GET", "/api/screens/%s/screenshot%s" % (screen_id, q), raw=True,
                  headers={"Accept": "image/webp"})
    tmp = shot_path(screen_id) + ".tmp"
    with open(tmp, "wb") as f:
        f.write(data)
    os.replace(tmp, shot_path(screen_id))
    return shot_path(screen_id)


def fetch_all_shots(screens):
    """Latest stored screenshots (credit-exempt) for screens whose copy is older than ten minutes."""
    for s in screens:
        path = shot_path(s["id"])
        if os.path.exists(path) and time.time() - os.path.getmtime(path) < 600:
            continue
        try:
            fetch_shot(s["id"])
        except Problem:
            pass


# ------------------------------------------------------------------- actions

def iso_in(minutes):
    return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(time.time() + minutes * 60))


def screen_action(screen_id, action, arg=None):
    base = "/api/screens/" + screen_id
    if action == "reload":
        api("POST", base + "/reload", {}, idempotent=True)
        return "Reload sent"
    if action == "reboot":
        api("POST", base + "/reboot", {}, idempotent=True)
        return "Reboot sent"
    if action == "restart-app":
        api("POST", base + "/restart-app", {}, idempotent=True)
        return "App restart sent"
    if action == "display-off":
        api("POST", base + "/display", {"power": "off"}, idempotent=True)
        return "Display off"
    if action == "display-on":
        api("DELETE", base + "/display", idempotent=True)
        return "Display back on"
    if action == "switch":
        api("PATCH", base, {"playlist_id": arg}, idempotent=True)
        return "Playlist switched"
    if action == "override":
        playlist, minutes = arg.split(":", 1)
        api("POST", base + "/takeover", {"playlist_id": playlist, "until": iso_in(int(minutes)),
                                          "reason": "Override from Omarchy"}, idempotent=True)
        return "Override for %s min" % minutes
    if action == "end-override":
        api("DELETE", base + "/takeover", idempotent=True)
        return "Override ended"
    if action == "shot":
        fetch_shot(screen_id, fresh=True)
        return "Screenshot updated"
    raise Problem("Unknown action %s" % action)


def upload_media(path):
    cfg, _ = access_token()
    pid = project_id(cfg)
    ctype = mimetypes.guess_type(path)[0] or ""
    allowed = {"image/png", "image/jpeg", "image/webp", "image/gif", "video/mp4", "video/webm"}
    if ctype not in allowed:
        raise Problem("screenRIG shows PNG, JPEG, WebP, GIF, MP4 and WebM files; %s is %s." % (
            os.path.basename(path), ctype or "an unknown type"))
    with open(path, "rb") as f:
        data = f.read()
    digest = hashlib.sha256(data).hexdigest()
    start = api("POST", "/api/projects/%s/media/uploads" % pid,
                {"filename": os.path.basename(path), "content_type": ctype, "bytes": len(data), "sha256": digest},
                idempotent=True)
    put = urllib.request.Request(start["upload_url"], data=data, method=start.get("method", "PUT"),
                                 headers=start.get("headers") or {})
    try:
        urllib.request.urlopen(put, timeout=300).read()
    except urllib.error.HTTPError as err:
        raise Problem("Upload refused: HTTP %d" % err.code)
    op = api("POST", "/api/media/uploads/%s/commit" % start["id"],
             {"content_type": ctype, "bytes": len(data), "sha256": digest}, idempotent=True)
    deadline = time.time() + 300
    while op.get("state") not in ("succeeded", "failed", "cancelled") and time.time() < deadline:
        time.sleep(1)
        op = api("GET", "/api/operations/" + op["id"])
    if op.get("state") != "succeeded":
        raise Problem("Processing %s failed: %s" % (os.path.basename(path),
                                                    (op.get("error") or {}).get("detail") or op.get("state")))
    return op["result"]["media_id"], ctype


def media_page(media_id, ctype):
    video = ctype.startswith("video/")
    return {
        "id": "p1",
        "canvas": {"width": 1920, "height": 1080, "background": "#000000FF"},
        "transition": {"type": "crossfade", "duration_ms": 500},
        "advance": {"mode": "media_end"} if video else {"mode": "duration", "after_ms": 60000},
        "primitives": [{"id": "m", "primitive": "video" if video else "image",
                        "selector": {"by": "id", "media_id": media_id},
                        "rect": {"x": 0, "y": 0, "width": 1920, "height": 1080},
                        "layer": 0, "content_fit": "contain"}],
    }


def send(screens, minutes, url=None, path=None):
    remember_cast(screens=screens)
    cfg, _ = access_token()
    pid = project_id(cfg)
    if not screens:
        raise Problem("Pick at least one screen.")
    if url:
        res = api("POST", "/api/projects/%s/tab-shares" % pid,
                  {"screen_ids": screens, "tabs": [{"url": url}], "until": iso_in(min(minutes, 1440))},
                  idempotent=True)
        skipped = res.get("skipped") or []
        warnings = [w.get("code", w) if isinstance(w, dict) else w for w in res.get("warnings") or []]
        msg = "Showing %s on %d screen(s) for %d min" % (url, len(res.get("screens") or screens) - len(skipped), minutes)
        if "embedding_blocked" in json.dumps(warnings):
            msg += "; the site refuses to be framed"
        if skipped:
            msg += "; %d skipped (no default playlist)" % len(skipped)
        return msg
    media_id, ctype = upload_media(path)
    name = "Sent from %s: %s" % (socket.gethostname(), os.path.basename(path))
    playlist = api("POST", "/api/projects/%s/playlists" % pid,
                   {"name": name[:120], "pages": [media_page(media_id, ctype)]}, idempotent=True)
    if playlist.get("state") == "pending_review" or "id" not in playlist:
        raise Problem("The playlist waits for a person's review before it can play.")
    failed = []
    for sid in screens:
        try:
            api("POST", "/api/screens/%s/takeover" % sid,
                {"playlist_id": playlist["id"], "until": iso_in(minutes), "reason": "Sent from Omarchy"},
                idempotent=True)
        except Problem as err:
            failed.append("%s: %s" % (sid, err))
    if failed and len(failed) == len(screens):
        raise Problem("; ".join(failed))
    return "Showing %s on %d screen(s) for %d min%s" % (
        os.path.basename(path), len(screens) - len(failed), minutes, "; failed " + "; ".join(failed) if failed else "")


def summon_panel(payload):
    subprocess.Popen(["omarchy-shell", "shell", "summon", PLUGIN_ID, json.dumps(payload)],
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def notify(title, body="", urgency="normal", actions=(), glyph="󰍹"):
    cmd = ["omarchy-notification-send", "--app-name", "screenRIG", "-g", glyph, "-u", urgency, title, body]
    for label, argv in actions[:3]:
        cmd += ["--action", label] + list(argv)
    try:
        subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except FileNotFoundError:
        subprocess.Popen(["notify-send", "-a", "screenRIG", "-u", urgency, title, body])


def capture():
    os.makedirs(os.path.join(CACHE, "captures"), exist_ok=True)
    out = os.path.join(CACHE, "captures", time.strftime("capture-%Y%m%d-%H%M%S.png"))
    region = subprocess.run(["slurp"], capture_output=True, text=True)
    if region.returncode != 0 or not region.stdout.strip():
        return "Capture cancelled"
    subprocess.run(["grim", "-g", region.stdout.strip(), out], check=True)
    summon_panel({"mode": "cast", "kind": "file", "source": "capture", "path": out})
    return out


def clip():
    types = subprocess.run(["wl-paste", "--list-types"], capture_output=True, text=True).stdout.split()
    for mime, ext in (("image/png", "png"), ("image/jpeg", "jpg"), ("image/webp", "webp")):
        if mime in types:
            os.makedirs(os.path.join(CACHE, "captures"), exist_ok=True)
            out = os.path.join(CACHE, "captures", time.strftime("clipboard-%Y%m%d-%H%M%S.") + ext)
            with open(out, "wb") as f:
                f.write(subprocess.run(["wl-paste", "--type", mime], capture_output=True).stdout)
            summon_panel({"mode": "cast", "kind": "file", "source": "clipboard", "path": out})
            return out
    text = subprocess.run(["wl-paste", "--no-newline"], capture_output=True, text=True).stdout.strip()
    if re.match(r"^https://\S+$", text):
        summon_panel({"mode": "cast", "kind": "url", "source": "clipboard", "url": text})
        return text
    if text.startswith("/") and os.path.isfile(text):
        summon_panel({"mode": "cast", "kind": "file", "source": "clipboard", "path": text})
        return text
    notify("Nothing to cast", "Copy an https link or an image first.", "low")
    return "Clipboard holds no https link or image"


def pick_file():
    proc = subprocess.run(["zenity", "--file-selection", "--title=Cast to a screen",
                           "--file-filter=Images and video | *.png *.jpg *.jpeg *.webp *.gif *.mp4 *.webm"],
                          capture_output=True, text=True)
    path = proc.stdout.strip()
    if proc.returncode != 0 or not path:
        return "Cancelled"
    summon_panel({"mode": "cast", "kind": "file", "source": "file", "path": path})
    return path


# --------------------------------------------------------------- agent chat
#
# A headless session with an installed agent integration, resumed on
# every message. Events are normalized to one JSON line each:
#   {"kind": "text", "text"} {"kind": "tool", "id", "title", "status", "output"}
#   {"kind": "error", "text"} {"kind": "session", "agent", "session"} {"kind": "done", "ok"}
# and the transcript is kept beside the session id so the panel can show it again.

AGENT_DIR = os.path.join(STATE, "agent")


def default_agent():
    try:
        out = subprocess.run(["omarchy-default-agent"], capture_output=True, text=True, timeout=10).stdout.strip()
    except FileNotFoundError:
        out = ""
    return out or "claude"


def agent_state():
    os.makedirs(AGENT_DIR, mode=0o700, exist_ok=True)
    path = os.path.join(AGENT_DIR, "session.json")
    try:
        with open(path) as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


def save_agent_state(state):
    path = os.path.join(AGENT_DIR, "session.json")
    with open(path + ".tmp", "w") as f:
        json.dump(state, f)
    os.replace(path + ".tmp", path)


def transcript_add(entry):
    os.makedirs(AGENT_DIR, mode=0o700, exist_ok=True)
    with open(os.path.join(AGENT_DIR, "transcript.jsonl"), "a") as f:
        f.write(json.dumps(dict(entry, at=time.time())) + "\n")


def agent_workspace():
    """The agent's working folder: what it is for, and the selected project."""
    work = os.path.join(AGENT_DIR, "workspace")
    os.makedirs(work, exist_ok=True)
    cfg = load_config()
    brief = (
        "# screenRIG desktop agent\n\n"
        "You answer the chat in the screenRIG panel on this Omarchy desktop. The person manages the\n"
        "signage screens of the screenRIG project %s (%s, organization %s).\n\n"
        "- Use the screenRIG skill and its `screenrig` CLI for everything about screens, playlists,\n"
        "  media, cards and schedules. The CLI is already signed in to this project.\n"
        "- Check each screen you change with a screenshot before you say it is done.\n"
        "- Answer briefly in plain text; the panel shows your messages in a narrow chat.\n"
    ) % (cfg.get("project_name") or "", cfg.get("project_id") or "", cfg.get("organization_name") or "")
    for name in ("AGENTS.md", "CLAUDE.md"):
        path = os.path.join(work, name)
        try:
            with open(path) as f:
                if f.read() == brief:
                    continue
        except OSError:
            pass
        with open(path, "w") as f:
            f.write(brief)
    return work


def short_command(command):
    m = re.match(r"""^\S*bash -lc (['"])(.*)\1$""", command or "", re.S)
    if m:
        command = m.group(2)
    m = None
    return (command or "").strip().splitlines()[0][:160] if (command or "").strip() else ""


def tidy(title):
    """A tool line people can read: CLI calls as `screenrig …`, absolute paths as their names."""
    t = title or ""
    t = re.sub(r"(?:node\s+)?\S*screenrig-plugin-freshness(?:\s+--host\s+\S+)?\s+--run\b", "screenrig", t)
    t = re.sub(r"(?:node\s+)?\S*/cli/dist/bin\.js\b", "screenrig", t)
    t = re.sub(r"(?<![\w.-])/(?:[\w.@+-]+/)+([\w.@+-]+)", r"\1", t)
    return re.sub(r"\s+", " ", t).strip()[:160]


def tool_title(name, args):
    args = args or {}
    for key in ("command", "description", "file_path", "path", "url", "pattern", "query"):
        if isinstance(args.get(key), str) and args[key].strip():
            return "%s  %s" % (name, args[key].strip().splitlines()[0][:140])
    return name


def last_line(text):
    lines = [l for l in (text or "").strip().splitlines() if l.strip()]
    return lines[-1][:160] if lines else ""


def agent_command(agent, session, text):
    if agent == "codex":
        cmd = ["codex", "exec", "--json", "--skip-git-repo-check"]
        return cmd + (["resume", session, text] if session else [text])
    if agent == "claude":
        cmd = ["claude", "-p", text, "--output-format", "stream-json", "--verbose", "--permission-mode", "auto"]
        return cmd + (["--resume", session] if session else [])
    if agent == "grok":
        cmd = ["grok", "-p", text, "--output-format", "streaming-messages-json", "--permission-mode", "auto"]
        return cmd + (["--resume", session] if session else [])
    raise Problem("Install Claude Code, Codex or Grok and the screenRIG plugin to use the panel chat.")


def normalize(agent, event, turn):
    """One agent event as zero or more normalized events."""
    out = []
    t = event.get("type")
    if agent == "codex":
        if t == "thread.started":
            out.append({"kind": "session", "session": event.get("thread_id")})
        elif t == "turn.started":
            turn["started"] = True
        elif t in ("item.started", "item.completed"):
            item = event.get("item") or {}
            it = item.get("type")
            if it == "agent_message" and t == "item.completed":
                out.append({"kind": "text", "text": (item.get("text") or "").strip()})
            elif it == "command_execution":
                status = "running" if t == "item.started" else ("done" if item.get("exit_code") == 0 else "failed")
                out.append({"kind": "tool", "id": item.get("id"), "title": short_command(item.get("command")),
                            "status": status, "output": last_line(item.get("aggregated_output"))})
            elif it == "file_change" and t == "item.completed":
                files = ", ".join(os.path.basename(c.get("path", "")) for c in item.get("changes") or [])
                out.append({"kind": "tool", "id": item.get("id"), "title": "edit  " + files, "status": "done"})
            elif it == "mcp_tool_call":
                status = "running" if t == "item.started" else ("failed" if item.get("error") else "done")
                out.append({"kind": "tool", "id": item.get("id"),
                            "title": "%s %s" % (item.get("server", ""), item.get("tool", "")), "status": status})
            elif it == "web_search" and t == "item.completed":
                out.append({"kind": "tool", "id": item.get("id"), "title": "search  " + (item.get("query") or ""), "status": "done"})
            elif it == "error" and t == "item.completed" and turn.get("started"):
                out.append({"kind": "error", "text": item.get("message") or "Error"})
        elif t in ("turn.failed", "error"):
            err = event.get("error") or {}
            out.append({"kind": "error", "text": err.get("message") if isinstance(err, dict) else str(event.get("message") or err)})
    else:
        if t == "system" and event.get("subtype") == "init":
            out.append({"kind": "session", "session": event.get("session_id")})
        elif t == "assistant":
            for block in (event.get("message") or {}).get("content") or []:
                if block.get("type") == "text" and block.get("text", "").strip():
                    out.append({"kind": "text", "text": block["text"].strip()})
                elif block.get("type") == "tool_use":
                    out.append({"kind": "tool", "id": block.get("id"), "title": tool_title(block.get("name", "tool"), block.get("input")),
                                "status": "running"})
        elif t == "user":
            for block in (event.get("message") or {}).get("content") or []:
                if isinstance(block, dict) and block.get("type") == "tool_result":
                    content = block.get("content")
                    if isinstance(content, list):
                        content = " ".join(c.get("text", "") for c in content if isinstance(c, dict))
                    out.append({"kind": "tool", "id": block.get("tool_use_id"), "status": "failed" if block.get("is_error") else "done",
                                "output": last_line(content if isinstance(content, str) else "")})
        elif t == "result":
            if event.get("session_id"):
                out.append({"kind": "session", "session": event.get("session_id")})
            if event.get("is_error"):
                out.append({"kind": "error", "text": event.get("result") or "The agent stopped with an error"})
    return out


def agent_send(text):
    agent = panel_agent()
    state = agent_state()
    session = state.get("session") if state.get("agent") == agent else None
    command = agent_command(agent, session, text)
    transcript_add({"role": "user", "text": text})
    emit({"kind": "start", "agent": agent, "name": AGENT_NAMES.get(agent, agent), "resumed": bool(session)})
    errors = tempfile.TemporaryFile(mode="w+")
    proc = subprocess.Popen(command, cwd=agent_workspace(), stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                            stderr=errors, text=True, bufsize=1)
    def stop(signum, frame):
        proc.terminate()
        try:
            proc.wait(timeout=5)
        except subprocess.TimeoutExpired:
            proc.kill()
        transcript_add({"role": "error", "text": "Stopped"})
        emit({"kind": "error", "text": "Stopped"})
        emit({"kind": "done", "ok": False})
        sys.exit(143)
    signal.signal(signal.SIGTERM, stop)
    turn = {}
    tools = {}
    for line in proc.stdout:
        line = line.strip()
        if not line.startswith("{"):
            continue
        try:
            event = json.loads(line)
        except ValueError:
            continue
        for ev in normalize(agent, event, turn):
            if ev["kind"] == "session" and ev.get("session"):
                save_agent_state({"agent": agent, "session": ev["session"]})
                continue
            if ev["kind"] == "tool":
                if ev.get("title"):
                    ev["title"] = tidy(ev["title"])
                merged = dict(tools.get(ev.get("id"), {}), **{k: v for k, v in ev.items() if v not in (None, "")})
                tools[ev.get("id")] = merged
                ev = merged
                if ev.get("status") != "running":
                    transcript_add({"role": "tool", "title": ev.get("title", ""), "status": ev["status"], "output": ev.get("output", "")})
            elif ev["kind"] == "text":
                transcript_add({"role": "agent", "text": ev["text"]})
            elif ev["kind"] == "error":
                transcript_add({"role": "error", "text": ev["text"]})
            emit(ev)
    code = proc.wait()
    if code != 0:
        errors.seek(0)
        err = last_line(errors.read())
        if err:
            transcript_add({"role": "error", "text": err})
            emit({"kind": "error", "text": err})
    emit({"kind": "done", "ok": code == 0})
    return code


def agent_history():
    path = os.path.join(AGENT_DIR, "transcript.jsonl")
    entries = []
    try:
        with open(path) as f:
            for line in f:
                try:
                    entry = json.loads(line)
                    if entry.get("role") == "tool":
                        entry["title"] = tidy(entry.get("title"))
                    entries.append(entry)
                except ValueError:
                    pass
    except OSError:
        pass
    agent = panel_agent()
    return {"ok": True, "agent": agent, "name": AGENT_NAMES.get(agent, agent), "entries": entries[-300:]}


def agent_reset():
    for name in ("session.json", "transcript.jsonl"):
        try:
            os.remove(os.path.join(AGENT_DIR, name))
        except OSError:
            pass
    return "New chat"


def open_url(url):
    subprocess.Popen(["xdg-open", url], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    return url


# ---------------------------------------------------------------- theme sync

def read_theme_colors(path=THEME_COLORS):
    colors = {}
    try:
        with open(path) as f:
            for line in f:
                m = re.match(r'^\s*([A-Za-z0-9_]+)\s*=\s*"([^"]*)"', line)
                if m:
                    colors[m.group(1)] = m.group(2)
    except FileNotFoundError:
        raise Problem("No Omarchy theme colors at %s" % path)
    return colors


def hex6(value):
    v = (value or "").strip()
    if re.match(r"^#[0-9a-fA-F]{6}$", v):
        return v.lower()
    if re.match(r"^#[0-9a-fA-F]{8}$", v):
        return v[:7].lower()
    return None


def theme_params(colors):
    accent = hex6(colors.get("accent") or colors.get("blue") or colors.get("color4"))
    bg = hex6(colors.get("background") or colors.get("color0"))
    fg = hex6(colors.get("foreground") or colors.get("color7"))
    if not (accent and bg and fg):
        raise Problem("The current theme has no accent, background and foreground colors.")
    return {"accent": accent, "backgroundColor": bg, "textColor": fg}


THEME_FLAG = os.path.join(STATE, "theme-sync")
THEME_ORIGINALS = os.path.join(STATE, "theme-originals.json")


def theme_sync_apply():
    cfg, _ = access_token()
    pid = project_id(cfg)
    params = theme_params(read_theme_colors())
    cards = paged("/api/cards?project=" + pid)
    originals = {}
    if os.path.exists(THEME_ORIGINALS):
        with open(THEME_ORIGINALS) as f:
            originals = json.load(f)
    changed, failed = 0, []
    for card in cards:
        current = card.get("params") or {}
        if card["id"] not in originals:
            originals[card["id"]] = {k: current.get(k) for k in params}
        if all(current.get(k) == v for k, v in params.items()):
            continue
        try:
            api("PATCH", "/api/cards/" + card["id"], {"params": dict(current, **params)}, idempotent=True)
            changed += 1
        except Problem as err:
            failed.append("%s: %s" % (card["id"], err))
    os.makedirs(STATE, exist_ok=True)
    with open(THEME_ORIGINALS, "w") as f:
        json.dump(originals, f)
    msg = "Matched %d card(s) to %s" % (changed, theme_name())
    if failed:
        msg += "; %d failed (%s)" % (len(failed), failed[0])
    return msg


def theme_sync_restore():
    if not os.path.exists(THEME_ORIGINALS):
        return "Nothing to restore"
    with open(THEME_ORIGINALS) as f:
        originals = json.load(f)
    restored = 0
    for card_id, before in originals.items():
        try:
            card = api("GET", "/api/cards/" + card_id)
        except Problem:
            continue
        params = dict(card.get("params") or {})
        for k, v in before.items():
            if v is None:
                params.pop(k, None)
            else:
                params[k] = v
        api("PATCH", "/api/cards/" + card_id, {"params": params}, idempotent=True)
        restored += 1
    os.remove(THEME_ORIGINALS)
    return "Restored %d card(s) to their own colors" % restored


def theme_name():
    try:
        with open(os.path.join(os.path.dirname(os.path.dirname(THEME_COLORS)), "theme.name")) as f:
            return f.read().strip() or "the theme"
    except OSError:
        return "the theme"


# -------------------------------------------------------------------- player

def player_binary():
    for p in (os.path.join(HOME, ".local/opt/screenrig-player/screenrig-player"), "/opt/screenrig-player/screenrig-player"):
        if os.access(p, os.X_OK):
            return p
    return None


def player_pids():
    out = subprocess.run(["pgrep", "-f", PLAYER_STATE], capture_output=True, text=True).stdout.split()
    return [int(p) for p in out if int(p) != os.getpid()]


def hypr(dispatch):
    return subprocess.run(["hyprctl", "dispatch", dispatch], capture_output=True, text=True)


def monitors():
    out = subprocess.run(["hyprctl", "monitors", "-j"], capture_output=True, text=True).stdout
    try:
        return [{"name": m["name"], "description": m.get("description", ""), "width": m["width"],
                 "height": m["height"], "focused": m.get("focused", False)} for m in json.loads(out)]
    except Exception:
        return []


def player_dir():
    """Per project: this machine's fleet link and the Player's own state."""
    cfg = load_config()
    path = os.path.join(PLAYER_STATE, project_id(cfg))
    os.makedirs(path, mode=0o700, exist_ok=True)
    return path


def provision():
    """This machine's fleet link for the selected project, created once.

    The link is a credential that creates screens: it lives only in a 0600
    file the Player reads, never on a command line, in output or in logs.
    """
    path = player_dir()
    link_file = os.path.join(path, "fleet-link")
    meta_file = os.path.join(path, "fleet-link.json")
    if os.path.exists(link_file) and os.path.getsize(link_file) > 0:
        return link_file
    cfg = load_config()
    name = "%s Omarchy Player" % socket.gethostname()
    data = run_cli(["fleet-links", "create", "--name", name[:80], "--max-screens", "1", "--tag", "omarchy"])
    url = data.get("url") or (data.get("fleet_link") or {}).get("url")
    link_id = data.get("id") or (data.get("fleet_link") or {}).get("id")
    if not url:
        raise Problem("The fleet link was created without a Player URL; see `screenrig fleet-links list`.")
    fd = os.open(link_file, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        f.write(url + "\n")
    with open(meta_file, "w") as f:
        json.dump({"id": link_id, "name": name, "project": project_id(cfg)}, f)
    return link_file


def player_start(monitor=None):
    if player_pids():
        return "The Player is already running"
    binary = player_binary()
    if not binary:
        raise Problem("Install the screenRIG Player for Linux first.")
    link_file = provision()
    state = os.path.join(player_dir(), "player")
    os.makedirs(state, mode=0o700, exist_ok=True)
    cmd = "env SCREENRIG_FLEET_LINK_FILE=%s %s --state-dir %s" % (link_file, binary, state)
    if monitor:
        hypr('hl.dsp.focus({ monitor = "%s" })' % monitor)
    res = hypr("hl.dsp.exec_cmd([[[fullscreen] %s]])" % cmd)
    if res.returncode != 0 or "error" in (res.stdout + res.stderr).lower():
        subprocess.Popen(cmd.split(), stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    return "Player started%s; it joins %s as its own screen" % (
        " on " + monitor if monitor else "", load_config().get("project_name") or "the project")


def player_stop():
    pids = player_pids()
    for pid in pids:
        try:
            os.kill(pid, 15)
        except ProcessLookupError:
            pass
    return "Player stopped" if pids else "The Player was not running"


def player_forget():
    """Stop the Player and delete this machine's fleet link; the screen it made stays in the project."""
    player_stop()
    path = player_dir()
    meta_file = os.path.join(path, "fleet-link.json")
    if os.path.exists(meta_file):
        with open(meta_file) as f:
            link_id = (json.load(f) or {}).get("id")
        if link_id:
            run_cli(["fleet-links", "delete", link_id])
        os.remove(meta_file)
    for name in ("fleet-link",):
        target = os.path.join(path, name)
        if os.path.exists(target):
            os.remove(target)
    return "This machine's fleet link is deleted; its screen stays in the project"


def player_status():
    running = bool(player_pids())
    provisioned = False
    try:
        provisioned = os.path.exists(os.path.join(player_dir(), "fleet-link"))
    except Problem:
        pass
    return {"ok": running, "running": running, "native": bool(player_binary()), "provisioned": provisioned,
            "monitors": monitors()}


# --------------------------------------------------------------- live cast
#
# A monitor or one window, captured with gpu-screen-recorder (hardware H.264)
# into a local mediamtx that serves RTSP over TCP on the LAN. Android and Qt
# Players on this network play it directly through a `stream` page; screens
# elsewhere cannot reach this laptop and are not offered.

LIVE_DIR = os.path.join(STATE, "live")
LIVE_BIN = os.path.join(HOME, ".local", "share", "screenrig-omarchy", "bin")
MEDIAMTX_VERSION = "v1.21.3"
LIVE_PORT = 8554
LIVE_PLATFORMS = ("android", "qt")
LIVE_NOTICE = "Live cast"
# "Until I stop" casts hold a takeover lease the keep-alive renews; if the laptop
# vanishes the lease runs out and the screens return to their own content.
LIVE_LEASE_MIN = 75
LIVE_RENEW_S = 3600
ASSETS = os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "assets")
FALLBACK_VERSION = 2


def lan_ip():
    out = subprocess.run(["ip", "-4", "route", "get", "1.1.1.1"], capture_output=True, text=True).stdout
    m = re.search(r"\bsrc (\d+\.\d+\.\d+\.\d+)", out)
    if not m:
        raise Problem("This laptop has no network route.")
    return m.group(1)


def lan_subnet(ip):
    out = subprocess.run(["ip", "-4", "-o", "addr", "show"], capture_output=True, text=True).stdout
    for line in out.splitlines():
        m = re.search(r"inet (%s)/(\d+)" % re.escape(ip), line)
        if m:
            bits = int(m.group(2))
            mask = (0xFFFFFFFF << (32 - bits)) & 0xFFFFFFFF
            n = int.from_bytes(socket.inet_aton(ip), "big") & mask
            return "%s/%d" % (socket.inet_ntoa(n.to_bytes(4, "big")), bits)
    return ip + "/32"


def public_ip():
    with urllib.request.urlopen("https://1.1.1.1/cdn-cgi/trace", timeout=10) as resp:
        for line in resp.read().decode().splitlines():
            if line.startswith("ip="):
                return line[3:].strip()
    raise Problem("Could not learn this network's public address.")


def screen_platform(s):
    return ((s.get("host") or {}).get("platform") or (s.get("player") or {}).get("kind") or "").lower()


def live_targets():
    """Online Android and Qt screens behind the same public address as this laptop."""
    cfg, _ = access_token()
    here = public_ip()
    out = []
    for s in paged("/api/screens?project=" + project_id(cfg)):
        if s.get("state") != "active":
            continue
        platform = screen_platform(s)
        out.append({"id": s["id"], "label": s.get("label") or s["id"], "online": bool(s.get("online")),
                     "platform": platform, "castable": platform in LIVE_PLATFORMS,
                     "local": s.get("last_ip") == here})
    usable = [t for t in out if t["castable"] and t["local"] and t["online"]]
    usable.sort(key=lambda t: t["label"].lower())
    return {"ok": True, "public_ip": here, "lan_ip": lan_ip(), "screens": usable,
            "elsewhere": len([t for t in out if t["castable"] and t["online"] and not t["local"]])}


def mediamtx_binary():
    path = os.path.join(LIVE_BIN, "mediamtx")
    if os.access(path, os.X_OK):
        return path
    os.makedirs(LIVE_BIN, exist_ok=True)
    base = "https://github.com/bluenviron/mediamtx/releases/download/%s/" % MEDIAMTX_VERSION
    name = "mediamtx_%s_linux_amd64.tar.gz" % MEDIAMTX_VERSION
    with urllib.request.urlopen(base + "checksums.sha256", timeout=60) as resp:
        sums = resp.read().decode()
    expected = next((l.split()[0] for l in sums.splitlines() if l.strip().endswith(name)), None)
    if not expected:
        raise Problem("The mediamtx release has no checksum for %s." % name)
    with urllib.request.urlopen(base + name, timeout=300) as resp:
        blob = resp.read()
    if hashlib.sha256(blob).hexdigest() != expected:
        raise Problem("The mediamtx download does not match its published checksum.")
    import io
    import tarfile
    with tarfile.open(fileobj=io.BytesIO(blob)) as tar:
        member = tar.getmember("mediamtx")
        with tar.extractfile(member) as src, open(path + ".tmp", "wb") as dst:
            dst.write(src.read())
    os.chmod(path + ".tmp", 0o755)
    os.replace(path + ".tmp", path)
    return path


def mediamtx_config():
    os.makedirs(LIVE_DIR, mode=0o700, exist_ok=True)
    path = os.path.join(LIVE_DIR, "mediamtx.yml")
    with open(path, "w") as f:
        f.write(
            "logLevel: info\n"
            "api: no\nmetrics: no\npprof: no\nplayback: no\n"
            "rtsp: yes\nrtspAddress: :%d\nrtspTransports: [tcp]\nrtspEncryption: \"no\"\n"
            "rtmp: no\n"
            "hls: no\nwebrtc: no\nsrt: no\n"
            "paths:\n  live:\n" % LIVE_PORT)
    return path


def firewall_state(subnet):
    """ok, needed, inactive (no ufw) or no-sudo (ufw on, but sudo asks for a password)."""
    if subprocess.run(["systemctl", "is-active", "--quiet", "ufw"]).returncode != 0:
        return "inactive"
    status = subprocess.run(["sudo", "-n", "ufw", "status"], capture_output=True, text=True)
    if status.returncode != 0:
        return "no-sudo"
    if re.search(r"^%d/tcp\s+ALLOW\s+%s" % (LIVE_PORT, re.escape(subnet)), status.stdout, re.M):
        return "ok"
    return "needed"


def picker_ready():
    try:
        with open(XDPH_CONF) as f:
            return bool(re.search(r"^\s*custom_picker_binary\s*=\s*%s\s*$" % re.escape(PICKER_LINK), f.read(), re.M))
    except OSError:
        return False


def live_setup_status():
    subnet = lan_subnet(lan_ip())
    return {"ok": True, "firewall": firewall_state(subnet), "picker": picker_ready(), "subnet": subnet, "port": LIVE_PORT}


def live_unsetup():
    """Undo live-setup: drop the ufw rule (when sudo needs no password) and restore the picker."""
    done = []
    try:
        subnet = lan_subnet(lan_ip())
    except Problem:
        subnet = None
    if subnet and firewall_state(subnet) == "ok":
        subprocess.run(["sudo", "-n", "ufw", "delete", "allow", "from", subnet, "to", "any", "port", str(LIVE_PORT),
                        "proto", "tcp"], capture_output=True)
        done.append("ufw rule removed")
    original = os.path.join(STATE, "xdph-original-picker")
    if picker_ready() and os.path.exists(original):
        with open(original) as f:
            previous = f.read().strip() or "hyprland-share-picker"
        with open(XDPH_CONF) as f:
            text = f.read()
        text = re.sub(r"^(\s*custom_picker_binary\s*=\s*).*$", lambda m: m.group(1) + previous, text, count=1, flags=re.M)
        with open(XDPH_CONF, "w") as f:
            f.write(text)
        subprocess.run(["systemctl", "--user", "try-restart", "xdg-desktop-portal-hyprland"], capture_output=True)
        done.append("screen-share picker restored")
    return "; ".join(done) or "Nothing to undo"


def live_setup(firewall=True, picker=True):
    """The changes live casting needs, made only after the person allows them in the panel."""
    subnet = lan_subnet(lan_ip())
    done = []
    state = firewall_state(subnet)
    if firewall and state == "needed":
        subprocess.run(["sudo", "-n", "ufw", "allow", "from", subnet, "to", "any", "port", str(LIVE_PORT),
                        "proto", "tcp", "comment", "screenRIG live cast"], capture_output=True, check=True)
        done.append("ufw allows TCP %d from %s" % (LIVE_PORT, subnet))
    elif firewall and state == "no-sudo":
        raise Problem("Run once: sudo ufw allow from %s to any port %d proto tcp comment 'screenRIG live cast'"
                      % (subnet, LIVE_PORT))
    if picker and setup_picker():
        done.append("window casts answer the screen-share picker")
    return "Live casting is set up" + (": " + "; ".join(done) if done else "")


def solid_png(width=1280, height=720, rgb=(11, 12, 14)):
    import struct
    import zlib
    row = b"\x00" + bytes(rgb) * width
    raw = zlib.compress(row * height, 9)

    def chunk(kind, data):
        return struct.pack(">I", len(data)) + kind + data + struct.pack(">I", zlib.crc32(kind + data) & 0xFFFFFFFF)
    return (b"\x89PNG\r\n\x1a\n" + chunk(b"IHDR", struct.pack(">IIBBBBB", width, height, 8, 2, 0, 0, 0))
            + chunk(b"IDAT", raw) + chunk(b"IEND", b""))


def live_project_state():
    cfg = load_config()
    path = os.path.join(LIVE_DIR, "project-%s.json" % project_id(cfg))
    try:
        with open(path) as f:
            return path, json.load(f)
    except (OSError, ValueError):
        return path, {}


def live_playlist(url):
    """The project's live stream playlist for this URL, made once."""
    cfg, _ = access_token()
    pid = project_id(cfg)
    path, state = live_project_state()
    current = state.get("fallback_version") == FALLBACK_VERSION
    if state.get("url") == url and state.get("playlist_id") and current:
        return state["playlist_id"]
    fallback = state.get("fallback_media_id") if current else None
    if not fallback:
        png = os.path.join(ASSETS, "live-fallback.png")
        if not os.path.exists(png):
            png = os.path.join(LIVE_DIR, "fallback.png")
            with open(png, "wb") as f:
                f.write(solid_png())
        fallback, _ = upload_media(png)
    page = {
        "id": "live",
        "canvas": {"width": 1920, "height": 1080, "background": "#000000FF"},
        "transition": {"type": "crossfade", "duration_ms": 300},
        "advance": {"mode": "duration", "after_ms": 30000},
        "primitives": [{"id": "stream", "primitive": "stream", "sources": [{"protocol": "rtsp", "url": url}],
                        "fallback_media_id": fallback, "muted": True,
                        "rect": {"x": 0, "y": 0, "width": 1920, "height": 1080}, "layer": 0, "content_fit": "contain"}],
    }
    playlist = api("POST", "/api/projects/%s/playlists" % pid,
                   {"name": "Live cast from %s" % socket.gethostname(), "pages": [page]}, idempotent=True)
    if "id" not in playlist:
        raise Problem("The live playlist waits for a person's review before it can play.")
    with open(path, "w") as f:
        json.dump({"url": url, "playlist_id": playlist["id"], "fallback_media_id": fallback,
                   "fallback_version": FALLBACK_VERSION}, f)
    return playlist["id"]


LAST_CAST = os.path.join(STATE, "last-cast.json")


def remember_cast(**fields):
    """What was cast last and where, so the Cast tab can preselect it."""
    try:
        with open(LAST_CAST) as f:
            last = json.load(f)
    except (OSError, ValueError):
        last = {}
    last.update({k: v for k, v in fields.items() if v})
    os.makedirs(STATE, exist_ok=True)
    with open(LAST_CAST + ".tmp", "w") as f:
        json.dump(last, f)
    os.replace(LAST_CAST + ".tmp", LAST_CAST)


def live_status():
    try:
        with open(os.path.join(LIVE_DIR, "live.json")) as f:
            state = json.load(f)
    except (OSError, ValueError):
        return {"ok": True, "live": False}
    alive = all(pid_alive(state.get(k)) for k in ("recorder_pid", "server_pid"))
    return dict(state, ok=True, live=alive)


def pid_alive(pid):
    if not pid:
        return False
    try:
        os.kill(int(pid), 0)
        return True
    except (OSError, ValueError):
        return False


def wait_for_stream(url, seconds=20):
    deadline = time.time() + seconds
    while time.time() < deadline:
        probe = subprocess.run(["ffprobe", "-v", "error", "-rtsp_transport", "tcp", "-select_streams", "v:0",
                                "-show_entries", "stream=codec_name", "-of", "csv=p=0", url],
                               capture_output=True, text=True, timeout=15)
        if probe.returncode == 0 and probe.stdout.strip():
            return True
        time.sleep(1)
    return False


def live_start(source, screens, minutes, label):
    if live_status().get("live"):
        live_stop()
    if not screens:
        raise Problem("Pick at least one screen on this network.")
    ip = lan_ip()
    if firewall_state(lan_subnet(ip)) in ("needed", "no-sudo"):
        raise Problem("Allow live casting in the Cast tab first: screens need to reach this laptop.")
    if source.startswith("window:") and not picker_ready():
        raise Problem("Allow window casting in the Cast tab first.")
    os.makedirs(LIVE_DIR, mode=0o700, exist_ok=True)
    logs = os.path.join(CACHE, "live")
    os.makedirs(logs, exist_ok=True)
    server = subprocess.Popen([mediamtx_binary(), mediamtx_config()], stdout=open(os.path.join(logs, "mediamtx.log"), "w"),
                              stderr=subprocess.STDOUT, start_new_session=True)
    state = {"server_pid": server.pid, "source": source, "label": label, "screens": screens,
             "started_at": time.time(), "url": "rtsp://%s:%d/live" % (ip, LIVE_PORT)}
    started = False
    try:
        time.sleep(0.6)
        if source.startswith("window:"):
            os.makedirs(CACHE, exist_ok=True)
            with open(os.path.join(CACHE, "live-pick"), "w") as f:
                f.write(source)
            capture = ["-w", "portal", "-restore-portal-session", "no"]
        elif source.startswith("screen:"):
            capture = ["-w", source.split(":", 1)[1]]
        else:
            raise Problem("Unknown live source %s" % source)
        state["recorder_pid"] = subprocess.Popen(["gpu-screen-recorder"] + capture + [
            "-f", "30", "-s", "1920x1080", "-k", "h264", "-bm", "cbr", "-q", "6000", "-keyint", "1", "-cursor", "yes",
            # Published over RTSP so the description carries a session name; Android's
            # Media3 rejects the empty `s= ` mediamtx writes for RTMP sources.
            "-c", "rtsp", "-ffmpeg-opts", "rtsp_transport=tcp", "-o", "rtsp://127.0.0.1:%d/live" % LIVE_PORT],
            stdout=open(os.path.join(logs, "recorder.log"), "w"), stderr=subprocess.STDOUT, start_new_session=True).pid
        with open(os.path.join(LIVE_DIR, "live.json"), "w") as f:
            json.dump(state, f)
        if not wait_for_stream("rtsp://127.0.0.1:%d/live" % LIVE_PORT):
            raise Problem("The capture did not start; see %s" % os.path.join(logs, "recorder.log"))
        playlist = live_playlist(state["url"])
        until = iso_in(minutes) if minutes > 0 else iso_in(LIVE_LEASE_MIN)
        shown, failed = [], []
        for sid in screens:
            try:
                api("POST", "/api/screens/%s/takeover" % sid,
                    {"playlist_id": playlist, "until": until, "reason": "Live cast from Omarchy"}, idempotent=True)
                shown.append(sid)
            except Problem as err:
                failed.append(str(err))
        if not shown:
            raise Problem("No screen took the cast: %s" % "; ".join(failed))
        # `until` is the cast's own end (none until stopped); the lease is the takeover's.
        state.update(playlist_id=playlist, screens=shown, until=until if minutes > 0 else None,
                     lease=minutes <= 0, renewed_at=time.time())
        keepalive = [sys.executable, os.path.realpath(__file__), "live-keepalive"]
        if shutil.which("systemd-inhibit"):
            keepalive = ["systemd-inhibit", "--what=sleep:shutdown", "--mode=delay", "--who=screenRIG",
                         "--why=Stop the live cast before sleeping"] + keepalive
        state["keepalive_pid"] = subprocess.Popen(keepalive, stdout=open(os.path.join(logs, "keepalive.log"), "w"),
                                                  stderr=subprocess.STDOUT, start_new_session=True).pid
        with open(os.path.join(LIVE_DIR, "live.json"), "w") as f:
            json.dump(state, f)
        remember_cast(source=source, label=label, screens=shown, minutes=str(minutes))
        # Stays up until the cast ends, so Stop is always one click away.
        ends = time.strftime(" · until %-I:%M %p", time.localtime(time.time() + minutes * 60)) if minutes > 0 else ""
        notify(LIVE_NOTICE, "%s on %d screen%s%s" % (label, len(shown), "" if len(shown) == 1 else "s", ends), "critical",
               [("Stop", ["screenrig-omarchy", "live-stop", "--notify"]),
                ("Open", ["omarchy-shell", "shell", "summon", PLUGIN_ID, json.dumps({"mode": "cast"})])], "󰑋")
        started = True
        return "Live: %s on %d screen%s" % (label, len(shown), "" if len(shown) == 1 else "s")
    finally:
        if not started:
            # Whatever failed after the capture began, end it the way Stop does.
            with open(os.path.join(LIVE_DIR, "live.json"), "w") as f:
                json.dump(state, f)
            live_stop()


def live_keepalive():
    """While a cast is live: renew its lease, end it if the capture dies, and stop it before sleep."""
    path = os.path.join(LIVE_DIR, "live.json")
    stop_now = threading.Event()
    monitors = []

    def watch_sleep():
        try:
            mon = subprocess.Popen(["gdbus", "monitor", "--system", "--dest", "org.freedesktop.login1",
                                    "--object-path", "/org/freedesktop/login1"],
                                   stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True)
        except FileNotFoundError:
            return
        monitors.append(mon)
        for line in mon.stdout:
            if re.search(r"PrepareFor(Sleep|Shutdown) \(true,\)", line):
                stop_now.set()
                return

    threading.Thread(target=watch_sleep, daemon=True).start()
    try:
        return keep_alive_loop(path, stop_now)
    finally:
        for mon in monitors:
            mon.terminate()


def keep_alive_loop(path, stop_now):
    while True:
        if stop_now.wait(timeout=10):
            live_stop()
            return 0
        try:
            with open(path) as f:
                state = json.load(f)
        except (OSError, ValueError):
            return 0
        if not (pid_alive(state.get("recorder_pid")) and pid_alive(state.get("server_pid"))):
            live_stop()
            notify("Live cast stopped", "The capture ended, so the screens went back to their own content.", "normal")
            return 0
        if state.get("lease") and time.time() - state.get("renewed_at", 0) >= LIVE_RENEW_S:
            until = iso_in(LIVE_LEASE_MIN)
            for sid in state.get("screens") or []:
                try:
                    api("POST", "/api/screens/%s/takeover" % sid,
                        {"playlist_id": state["playlist_id"], "until": until, "reason": "Live cast from Omarchy"},
                        idempotent=True)
                except Problem as err:
                    warn("lease renewal for %s failed: %s" % (sid, err))
            state["renewed_at"] = time.time()
            with open(path + ".tmp", "w") as f:
                json.dump(state, f)
            os.replace(path + ".tmp", path)


def live_stop():
    path = os.path.join(LIVE_DIR, "live.json")
    try:
        with open(path) as f:
            state = json.load(f)
    except (OSError, ValueError):
        return "Nothing is live"
    for sid in state.get("screens") or []:
        try:
            api("DELETE", "/api/screens/%s/takeover" % sid, idempotent=True)
        except Problem:
            pass
    for key, sig in (("recorder_pid", signal.SIGINT), ("server_pid", signal.SIGTERM), ("keepalive_pid", signal.SIGTERM)):
        if state.get(key) and int(state[key]) == os.getpgrp():
            continue
        if pid_alive(state.get(key)):
            try:
                os.killpg(int(state[key]), sig)
            except OSError:
                pass
    os.remove(path)
    subprocess.run(["omarchy-shell", "notifications", "dismiss", LIVE_NOTICE], capture_output=True)
    return "Live cast stopped"


# --------------------------------------------------------------------- setup
#
# `omarchy plugin add` only clones the plugin, so the service runs this on load.
# Idempotent: it changes only what differs, and says what it changed.

PICKER_LINK = os.path.join(HOME, ".local", "bin", "screenrig-share-picker")
XDPH_CONF = os.path.join(HOME, ".config", "hypr", "xdph.conf")


def plugin_root():
    return os.path.dirname(os.path.dirname(os.path.realpath(__file__)))


def place_file(src, dest, mode=0o644):
    try:
        with open(src, "rb") as f:
            data = f.read()
    except OSError:
        return False
    try:
        with open(dest, "rb") as f:
            if f.read() == data:
                return False
    except OSError:
        pass
    os.makedirs(os.path.dirname(dest), exist_ok=True)
    with open(dest + ".tmp", "wb") as f:
        f.write(data)
    os.chmod(dest + ".tmp", mode)
    os.replace(dest + ".tmp", dest)
    return True


def place_link(target, link):
    if os.path.islink(link) and os.readlink(link) == target:
        return False
    if os.path.exists(link) and not os.path.islink(link):
        return False
    os.makedirs(os.path.dirname(link), exist_ok=True)
    if os.path.islink(link):
        os.remove(link)
    os.symlink(target, link)
    return True


def setup_picker():
    """Point xdg-desktop-portal-hyprland's picker at the live-cast picker, remembering the old one."""
    if not (os.path.exists(XDPH_CONF) or shutil.which("xdg-desktop-portal-hyprland")
            or os.path.exists("/usr/lib/xdg-desktop-portal-hyprland")):
        return False
    try:
        with open(XDPH_CONF) as f:
            text = f.read()
    except OSError:
        text = ""
    m = re.search(r"^\s*custom_picker_binary\s*=\s*(.+?)\s*$", text, re.M)
    current = m.group(1) if m else ""
    if current == PICKER_LINK:
        return False
    os.makedirs(STATE, exist_ok=True)
    with open(os.path.join(STATE, "xdph-original-picker"), "w") as f:
        f.write((current or "hyprland-share-picker") + "\n")
    if text:
        with open(XDPH_CONF + ".bak.screenrig-" + time.strftime("%Y%m%d%H%M%S"), "w") as f:
            f.write(text)
    if m:
        text = text[:m.start(1)] + PICKER_LINK + text[m.end(1):]
    else:
        text += "\nscreencopy {\n    custom_picker_binary = %s\n}\n" % PICKER_LINK
    os.makedirs(os.path.dirname(XDPH_CONF), exist_ok=True)
    with open(XDPH_CONF, "w") as f:
        f.write(text)
    subprocess.run(["systemctl", "--user", "try-restart", "xdg-desktop-portal-hyprland"], capture_output=True)
    return True


def setup():
    root = plugin_root()
    changed = []
    bindir = os.path.join(HOME, ".local", "bin")
    if place_link(os.path.join(root, "bin", "screenrig-omarchy"), os.path.join(bindir, "screenrig-omarchy")):
        changed.append("helper")
    if place_link(os.path.join(root, "bin", "screenrig-share-picker"), PICKER_LINK):
        changed.append("picker")
    apps = os.path.join(os.environ.get("XDG_DATA_HOME") or os.path.join(HOME, ".local", "share"), "applications")
    desktop = False
    for name in ("screenrig-omarchy.desktop", "screenrig-send.desktop"):
        desktop |= place_file(os.path.join(root, "applications", name), os.path.join(apps, name))
    if desktop:
        subprocess.run(["update-desktop-database", apps], capture_output=True)
        changed.append("desktop entries")
    if place_file(os.path.join(root, "hooks", "theme-set"),
                  os.path.join(HOME, ".config", "omarchy", "hooks", "theme-set.d", "50-screenrig")):
        changed.append("theme hook")
    return "Set up: " + ", ".join(changed) if changed else "Already set up"


def teardown():
    """Undo everything the plugin set up, before `omarchy plugin remove screenrig.omarchy`."""
    done = []
    if live_status().get("live"):
        live_stop()
        done.append("live cast stopped")
    undone = live_unsetup()
    if undone != "Nothing to undo":
        done.append(undone)
    if menu_remove():
        done.append("menu rows removed")
    apps = os.path.join(os.environ.get("XDG_DATA_HOME") or os.path.join(HOME, ".local", "share"), "applications")
    for path in (os.path.join(apps, "screenrig-omarchy.desktop"), os.path.join(apps, "screenrig-send.desktop"),
                 os.path.join(HOME, ".config", "omarchy", "hooks", "theme-set.d", "50-screenrig")):
        if os.path.exists(path):
            os.remove(path)
            done.append(os.path.basename(path) + " removed")
    for link in (os.path.join(HOME, ".local", "bin", "screenrig-omarchy"), PICKER_LINK):
        if os.path.islink(link):
            os.remove(link)
            done.append(os.path.basename(link) + " unlinked")
    return "; ".join(done) or "Nothing to undo"


# ---------------------------------------------------------------------- menu

def jdump(value, **kw):
    """JSON for the menu file. Omarchy strips // lines with a JavaScript multiline regex, whose ^ also
    matches after U+2028 and U+2029, so a label holding one followed by // would lose the rest of its row."""
    return json.dumps(value, ensure_ascii=False, **kw).replace("\u2028", "\\u2028").replace("\u2029", "\\u2029")


def menu_rows(snap):
    rows = [
        ("screenrig", {"icon": "󰍹", "label": "screenRIG", "description": "Signage screens, casting, Player and agent",
                       "aliases": ["screenrig", "signage"]}),
        ("screenrig.stopcast", {"icon": "󰓛", "label": "Stop casting", "description": "End the live cast on every screen",
                                "action": "screenrig-omarchy live-stop --notify",
                                "when": "test -f %s" % os.path.join(STATE, "live", "live.json")}),
        ("screenrig.panel", {"icon": "󰕮", "label": "Screens", "description": "Open the screens panel",
                             "action": "omarchy-shell shell toggle " + PLUGIN_ID}),
        ("screenrig.capture", {"icon": "󰹑", "label": "Cast capture to a screen",
                               "description": "Select a region and show it on screens",
                               "action": "screenrig-omarchy capture"}),
        ("screenrig.clipboard", {"icon": "󰅇", "label": "Cast clipboard to a screen",
                                 "description": "Show the copied link or image on screens",
                                 "action": "screenrig-omarchy clip"}),
        ("screenrig.file", {"icon": "󰈙", "label": "Cast file to a screen",
                            "description": "Show an image or video on screens",
                            "action": "screenrig-omarchy pick-file"}),
        # The Become a screen row is hidden for now, with the panel's Player tab.
        ("screenrig.agent", {"icon": "󰚩", "label": "Ask your agent",
                             "description": "Chat with your agent about your screens",
                             "action": "omarchy-shell shell summon %s '{\"mode\":\"agent\"}'" % PLUGIN_ID}),
        # Theme matching rows are hidden for now, with the panel's Theme tab.
        ("screenrig.screens", {"icon": "󰍺", "label": "All screens", "description": "Every screen in the project"}),
        ("screenrig.playlists", {"icon": "󰲸", "label": "All playlists", "description": "Every playlist in the project"}),
    ]
    for s in snap["screens"]:
        key = "screenrig.screens." + s["id"]
        state = "online" if s["online"] else "offline"
        rows.append((key, {"icon": "󰍹", "label": s["label"],
                           "description": "screen %s %s" % (state, s.get("playing_name") or "")}))
        payload = json.dumps({"mode": "screens", "focus": s["id"]})
        rows += [
            (key + ".open", {"icon": "󰕮", "label": "Open " + s["label"],
                             "action": "omarchy-shell shell summon %s '%s'" % (PLUGIN_ID, payload)}),
            (key + ".reload", {"icon": "󰑓", "label": "Reload " + s["label"],
                               "action": "screenrig-omarchy act %s reload --notify" % s["id"]}),
            (key + ".dashboard", {"icon": "󰖟", "label": s["label"] + " in the dashboard",
                                  "action": "xdg-open %s/screens/%s" % (DASHBOARD, s["id"])}),
        ]
    for p in snap["playlists"]:
        rows.append(("screenrig.playlists." + p["id"], {"icon": "󰲸", "label": p["name"],
                                                        "description": "playlist",
                                                        "action": "xdg-open %s/playlists/%s" % (DASHBOARD, p["id"])}))
    return rows


def render_block(rows):
    lines = [MENU_BEGIN]
    for key, row in rows:
        lines.append("  %s: %s," % (jdump(key), jdump(row, separators=(",", ":"))))
    lines.append(MENU_END)
    return lines


def merge_menu(text, rows):
    """Place the generated rows right after the object's opening brace, replacing an earlier block."""
    lines = text.splitlines()
    if MENU_BEGIN.strip() in [l.strip() for l in lines]:
        start = next(i for i, l in enumerate(lines) if l.strip() == MENU_BEGIN.strip())
        end = next(i for i, l in enumerate(lines) if l.strip() == MENU_END.strip())
        del lines[start:end + 1]
    brace = next((i for i, l in enumerate(lines) if l.strip().startswith("{")), None)
    if brace is None:
        lines += ["{", "}"]
        brace = len(lines) - 2
    block = render_block(rows)
    rest = "\n".join(l for l in lines[brace + 1:] if not l.strip().startswith("//"))
    if not re.search(r'"\s*:', rest):
        block[-2] = block[-2].rstrip(",")
    lines[brace + 1:brace + 1] = block
    return "\n".join(lines) + "\n"


def menu_sync(snap):
    try:
        with open(MENU_FILE) as f:
            text = f.read()
    except FileNotFoundError:
        text = "{\n}\n"
    merged = merge_menu(text, menu_rows(snap))
    if merged != text:
        os.makedirs(os.path.dirname(MENU_FILE), exist_ok=True)
        tmp = MENU_FILE + ".screenrig-tmp"
        with open(tmp, "w") as f:
            f.write(merged)
        os.replace(tmp, MENU_FILE)
        return True
    return False


def menu_remove():
    try:
        with open(MENU_FILE) as f:
            lines = f.read().splitlines()
    except FileNotFoundError:
        return False
    stripped = [l.strip() for l in lines]
    if MENU_BEGIN.strip() not in stripped:
        return False
    start, end = stripped.index(MENU_BEGIN.strip()), stripped.index(MENU_END.strip())
    del lines[start:end + 1]
    with open(MENU_FILE, "w") as f:
        f.write("\n".join(lines) + "\n")
    return True


# -------------------------------------------------------------------- follow

class Follower:
    """Streams project events, keeps a fresh snapshot and raises desktop notifications."""

    def __init__(self, do_notify):
        self.do_notify = do_notify
        self.dirty = threading.Event()
        self.snap = None
        self.offline_notified = set()
        self.publish = {}
        self.publish_lock = threading.Lock()
        self.credits_low = None
        self.seen_reviews = None

    def refresh(self):
        try:
            self.snap = snapshot()
            emit(self.snap)
            low = self.snap["credits"].get("low")
            if low and self.credits_low is False and self.do_notify:
                notify("screenRIG credits are low", "%s credits left this month." % self.snap["credits"].get("remaining"),
                       "critical", [("Billing", ["xdg-open", DASHBOARD + "/billing/settings"])], "󰄬")
            if low is not None:
                self.credits_low = low
            try:
                menu_sync(self.snap)
            except OSError as err:
                warn("menu sync failed: %s" % err)
            fetch_all_shots(self.snap["screens"])
            emit(dict(self.snap, screens=[dict(s, shot=shot_path(s["id"]) if os.path.exists(shot_path(s["id"])) else "",
                                               shot_mtime=int(os.path.getmtime(shot_path(s["id"])))
                                               if os.path.exists(shot_path(s["id"])) else 0)
                                          for s in self.snap["screens"]]))
        except Problem as err:
            emit({"kind": "status", "ok": False, "error": str(err)})

    def snapshot_loop(self):
        last = 0.0
        while True:
            fired = self.dirty.wait(timeout=300)
            if fired:
                time.sleep(1.5)
                self.dirty.clear()
            if fired or time.time() - last >= 300:
                self.refresh()
                last = time.time()

    def reviews_loop(self):
        while True:
            try:
                cfg, _ = access_token()
                items = api("GET", "/api/advertising/reviews?project=" + project_id(cfg)).get("items") or []
                pending = {r["id"] for r in items if r.get("state") == "pending"}
                if self.seen_reviews is not None and self.do_notify:
                    for _ in pending - self.seen_reviews:
                        notify("An ad booking needs your review", "A buyer submitted creative for your screens.",
                               "normal", [("Review", ["xdg-open", DASHBOARD + "/advertising/seller-campaigns"])], "󰆼")
                self.seen_reviews = pending
            except (Problem, KeyError):
                pass
            time.sleep(600)

    def screen_name(self, sid, fallback):
        for s in (self.snap or {}).get("screens", []):
            if s["id"] == sid:
                return s["label"]
        return fallback or sid

    def flush_publish(self, playlist):
        with self.publish_lock:
            screens = self.publish.pop(playlist, set())
        if screens and self.do_notify:
            name = next((p["name"] for p in (self.snap or {}).get("playlists", []) if p["id"] == playlist), "A playlist")
            notify("Published: %s" % name, "Now showing on %d screen%s." % (len(screens), "" if len(screens) == 1 else "s"),
                   "low", [("Open", ["xdg-open", "%s/playlists/%s" % (DASHBOARD, playlist)])], "󰄬")

    def on_event(self, ev):
        etype = ev.get("type", "")
        if etype.startswith("screen.") or etype.startswith("playlist.") or etype.startswith("operation."):
            self.dirty.set()
        emit({"kind": "event", "type": etype, "resource": ev.get("resource"), "message": ev.get("message"),
              "at": ev.get("at")})
        if not self.do_notify:
            return
        res = ev.get("resource") or {}
        sid = res.get("id", "")
        name = self.screen_name(sid, res.get("name"))
        details = ev.get("details") or {}
        if etype == "screen.offline":
            self.offline_notified.add(sid)
            payload = json.dumps({"mode": "screens", "focus": sid})
            notify("%s went offline" % name, "Last online %s." % (details.get("last_online_at") or "")[11:16],
                   "critical", [("Open", ["omarchy-shell", "shell", "summon", PLUGIN_ID, payload]),
                                ("Reload", ["screenrig-omarchy", "act", sid, "reload", "--notify"]),
                                ("Dashboard", ["xdg-open", "%s/screens/%s" % (DASHBOARD, sid)])], "󰍹")
        elif etype == "screen.online" and sid in self.offline_notified:
            self.offline_notified.discard(sid)
            notify("%s is back online" % name, "", "low", glyph="󰍹")
        elif etype == "screen.manifest_upgrade" and details.get("state") == "current":
            playlist = next((s.get("playing_id") for s in (self.snap or {}).get("screens", []) if s["id"] == sid), None)
            if playlist:
                with self.publish_lock:
                    first = playlist not in self.publish
                    self.publish.setdefault(playlist, set()).add(sid)
                if first:
                    threading.Timer(10, self.flush_publish, [playlist]).start()

    def stream(self):
        cursor = None
        backoff = 1
        while True:
            try:
                cfg, token = access_token()
                url = "%s/stream/project?project=%s" % (cfg.get("api_url", "https://api.screenrig.ai").rstrip("/"),
                                                        project_id(cfg))
                headers = {"Authorization": "Bearer " + token, "Accept": "text/event-stream",
                           "User-Agent": "screenrig-omarchy"}
                if cursor:
                    headers["Last-Event-ID"] = cursor
                resp = urllib.request.urlopen(urllib.request.Request(url, headers=headers), timeout=45)
                emit({"kind": "status", "ok": True})
                backoff = 1
                event, data, ident = "message", [], None
                for raw in resp:
                    line = raw.decode(errors="replace").rstrip("\r\n")
                    if line == "":
                        if data:
                            if ident:
                                cursor = ident
                            if event == "reauth":
                                access_token(force=True)
                                break
                            if event == "stream.resync_required":
                                cursor = None
                                self.dirty.set()
                            elif event not in ("stream.cursor", "problem"):
                                try:
                                    self.on_event(json.loads("\n".join(data)))
                                except ValueError:
                                    pass
                        event, data, ident = "message", [], None
                    elif line.startswith(":"):
                        continue
                    elif line.startswith("event:"):
                        event = line[6:].strip()
                    elif line.startswith("data:"):
                        data.append(line[5:].lstrip())
                    elif line.startswith("id:"):
                        ident = line[3:].strip()
            except urllib.error.HTTPError as err:
                if err.code == 401:
                    try:
                        access_token(force=True)
                    except Problem as perr:
                        emit({"kind": "status", "ok": False, "error": str(perr)})
                else:
                    emit({"kind": "status", "ok": False, "error": problem_message(err.code, error_body(err))})
            except (Problem, OSError, urllib.error.URLError, http.client.HTTPException) as err:
                emit({"kind": "status", "ok": False, "error": str(err)})
            time.sleep(backoff)
            backoff = min(backoff * 2, 60)

    def run(self):
        threading.Thread(target=self.snapshot_loop, daemon=True).start()
        threading.Thread(target=self.reviews_loop, daemon=True).start()
        self.dirty.set()
        self.stream()


# ----------------------------------------------------------------------- cli

def flag(args, name, default=None):
    if name in args:
        i = args.index(name)
        val = args[i + 1] if i + 1 < len(args) else default
        del args[i:i + 2]
        return val
    return default


def main(argv):
    args = list(argv)
    if not args:
        print(__doc__.strip())
        return 2
    cmd = args.pop(0)
    notify_result = "--notify" in args
    if notify_result:
        args.remove("--notify")
    try:
        if cmd == "follow":
            Follower(do_notify=notify_result).run()
            return 0
        if cmd == "snapshot":
            emit(snapshot())
            return 0
        if cmd == "shot":
            path = fetch_shot(args[0], fresh="--fresh" in args)
            emit({"ok": True, "path": path})
            return 0
        if cmd == "act":
            msg = screen_action(args[0], args[1], args[2] if len(args) > 2 else None)
        elif cmd == "send":
            screens = [s for s in (flag(args, "--screens", "") or "").split(",") if s]
            minutes = int(flag(args, "--minutes", "10"))
            msg = send(screens, minutes, url=flag(args, "--url"), path=flag(args, "--file"))
        elif cmd == "send-file":
            summon_panel({"mode": "cast", "kind": "file", "source": "file", "path": os.path.abspath(args[0])})
            msg = "Pick screens in the panel"
        elif cmd == "capture":
            msg = capture()
        elif cmd == "clip":
            msg = clip()
        elif cmd == "pick-file":
            msg = pick_file()
        elif cmd == "agent-send":
            try:
                return agent_send(" ".join(args))
            except Problem as err:
                emit({"kind": "error", "text": str(err)})
                emit({"kind": "done", "ok": False})
                return 1
        elif cmd == "agent-history":
            emit(agent_history())
            return 0
        elif cmd == "agent-reset":
            msg = agent_reset()
        elif cmd == "open":
            msg = open_url(DASHBOARD + "/" + "/".join(args))
        elif cmd == "theme-sync":
            sub = args[0] if args else "apply"
            if sub == "apply":
                msg = theme_sync_apply()
            elif sub == "hook":
                if not os.path.exists(THEME_FLAG):
                    return 0
                msg = theme_sync_apply()
                notify_result = True
            elif sub == "restore":
                msg = theme_sync_restore()
            elif sub == "enabled":
                emit({"ok": os.path.exists(THEME_FLAG)})
                return 0 if os.path.exists(THEME_FLAG) else 1
            elif sub in ("on", "off", "toggle"):
                on = sub == "on" or (sub == "toggle" and not os.path.exists(THEME_FLAG))
                os.makedirs(STATE, exist_ok=True)
                if on:
                    open(THEME_FLAG, "w").close()
                    msg = "Cards follow the Omarchy theme. " + theme_sync_apply()
                else:
                    if os.path.exists(THEME_FLAG):
                        os.remove(THEME_FLAG)
                    msg = "Cards keep their colors when the theme changes"
                notify_result = True
            else:
                raise Problem("theme-sync apply|on|off|toggle|enabled|restore")
        elif cmd == "player":
            sub = args[0] if args else "status"
            if sub == "status":
                status = player_status()
                emit(status)
                return 0 if status["running"] else 1
            if sub == "start":
                msg = player_start(flag(args, "--monitor"))
            elif sub == "stop":
                msg = player_stop()
            elif sub == "toggle":
                msg = player_stop() if player_pids() else player_start()
                notify_result = True
            elif sub == "forget":
                msg = player_forget()
            else:
                raise Problem("player status|start|stop|toggle|forget")
        elif cmd == "menu-sync":
            changed = menu_sync(snapshot())
            msg = "Menu updated" if changed else "Menu already current"
        elif cmd == "menu-remove":
            msg = "Menu rows removed" if menu_remove() else "No menu rows to remove"
        elif cmd == "projects":
            emit({"ok": True, "projects": list_projects()})
            return 0
        elif cmd == "onboarding":
            emit(onboarding())
            return 0
        elif cmd == "install-plugin":
            msg = install_plugin()
        elif cmd == "login-start":
            emit(login_start())
            return 0
        elif cmd == "login-wait":
            msg = login_wait(args[0])
        elif cmd == "project-use":
            msg = use_project(args[0])
        elif cmd == "live-targets":
            emit(live_targets())
            return 0
        elif cmd == "live-status":
            emit(live_status())
            return 0
        elif cmd == "live-start":
            screens = [s for s in (flag(args, "--screens", "") or "").split(",") if s]
            msg = live_start(flag(args, "--source", ""), screens, int(flag(args, "--minutes", "60")),
                             flag(args, "--label", "") or "Desktop")
        elif cmd == "live-stop":
            msg = live_stop()
        elif cmd == "live-keepalive":
            return live_keepalive()
        elif cmd == "setup":
            msg = setup()
        elif cmd == "live-setup-status":
            emit(live_setup_status())
            return 0
        elif cmd == "live-setup":
            msg = live_setup()
        elif cmd == "live-unsetup":
            msg = live_unsetup()
        elif cmd == "teardown":
            msg = teardown()
        elif cmd == "monitors":
            emit({"ok": True, "monitors": monitors()})
            return 0
        else:
            raise Problem("Unknown command %s" % cmd)
    except Problem as err:
        emit({"ok": False, "message": str(err)})
        if notify_result:
            notify("screenRIG", str(err), "normal")
        return 1
    emit({"ok": True, "message": msg})
    if notify_result:
        notify("screenRIG", msg, "low")
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except KeyboardInterrupt:
        sys.exit(130)
